{
  "manifest_version": 3,
  "name": "File Converter — Download & Convert",
  "short_name": "File Converter",
  "version": "0.1.0",
  "description": "Download the images, videos and audio on any page and convert them (MP4, GIF, MP3, JPG, PNG, WEBP…) right in your browser. Nothing is uploaded.",
  "default_locale": "en",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "File Converter",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["contextMenus", "downloads", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
